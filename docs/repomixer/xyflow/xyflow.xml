    {id}
    {x}
    {y}
    {width}
    {height}
    {borderRadius}
    class={className}
    {color}
    {shapeRendering}
    {strokeColor}
    {strokeWidth}
    {selected}
  />
{:else}
  <rect
    class={['svelte-flow__minimap-node', className]}
    class:selected
    {x}
    {y}
    rx={borderRadius}
    ry={borderRadius}
    {width}
    {height}
