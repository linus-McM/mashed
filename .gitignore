.claude*
# Exception: ONLY the mashed-refactor-asset skill is tracked so
# first-time users get an on-ramp into the Skills tab of the BMAD
# workspace. Every other .claude/ path (other skills, agents,
# rules, settings) stays personal/ignored. The triple-negation
# pattern is required because .gitignore re-ignores entries under
# a re-ignored parent — we un-ignore .claude/, immediately
# re-ignore its direct children, un-ignore .claude/skills/, immediately
# re-ignore ITS direct children, and finally un-ignore the single
# skill directory we care about.
!.claude/
/.claude/*
!/.claude/skills/
/.claude/skills/*
!/.claude/skills/mashed-refactor-asset/
.desloppify/
.logs/
logs/
scorecard.png
build/bin
mashed
node_modules
frontend/dist
images/*
# macOS Finder metadata — ignore at any depth
**/.DS_Store
*.log
*.png
!frontend/src/**/*.png
.env
*.pem
*.key
*.crt
*.p12
*.jks
*.bak
*.tmp
*.swp
*.swo
*.zip
*.tar.gz
*.tar.bz2
*.7z
*.exe
*.dll
*.so
*.dylib
*.pyc
*.pyo
*.class
*.jar
*.war
*.ear
*.iml
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.code-workspace
*.sln
*.csproj
*.vbproj
*.suo
*.user
*.userosscache
*.sln.docstates
*.pid
*.seed
*.log
*.csv
*.dat
*.backup
console-**.log
nanobanana-output
docs/repomixer/*
repomix-output.xml
.wolf
.playwright-cli
.playwright-mcp
# Playwright test artifacts (generated by `npx playwright test`)
frontend/test-results/
frontend/playwright-report/
test-results/
playwright-report/

