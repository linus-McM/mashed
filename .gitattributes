# Bundled binaries are stored with Git LFS going forward (repo health R28).
# Existing blobs stay in history; clones without git-lfs get pointer files,
# which the scanners skip and `just check-lfs` rejects before a build.
themes/*.vsix filter=lfs diff=lfs merge=lfs -text
fonts/*.ttf filter=lfs diff=lfs merge=lfs -text
