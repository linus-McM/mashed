  class={['svelte-flow', 'svelte-flow__container', className, colorMode]}
  data-testid="svelte-flow__wrapper"
  role="application"
  onscroll={wrapperOnScroll}
  {...divAttributes satisfies OnlyDivAttributes<typeof divAttributes>}
